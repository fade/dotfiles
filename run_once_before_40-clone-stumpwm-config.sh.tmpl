#!/usr/bin/env bash
set -euo pipefail

# The StumpWM configuration in ~/.stumpwm.d is two symlinks into a Lisp system
# that lives with the other Lisp sources rather than in the dotfiles, because
# it is an asdf system loaded at startup and not a file the window manager
# reads. Without this clone both symlinks dangle and StumpWM starts on its
# own defaults.
parent="{{ .chezmoi.homeDir }}/SourceCode/lisp"
target="$parent/fade-stumpwm-init"
repo="git@github.com:fade/stumpwm-d.git"
repo_https="https://github.com/fade/stumpwm-d.git"

if [ -d "$target/.git" ]; then
    exit 0
fi

mkdir -p "$parent"

if [ -e "$target" ] && [ ! -d "$target" ]; then
    echo "run_once: $target exists and is not a directory; aborting" >&2
    exit 1
fi

if [ -d "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null || true)" ]; then
    echo "run_once: $target exists and is non-empty but not a git repo; aborting" >&2
    exit 1
fi

if git ls-remote "$repo" >/dev/null 2>&1; then
    git clone "$repo" "$target"
else
    git clone "$repo_https" "$target"
fi
