# Two-way sync of the working set against ghost, which is the root of truth.
#
# Run it as: unison ghost
#
# What is here is what I would be sorry to lose and cannot get back from
# anywhere else: work in progress, the agent configuration, and the planning
# directories that every project symlinks into. What is not here is anything a
# remote, a package manager or a download already holds.

root = {{ .chezmoi.homeDir }}
root = ssh://fade@ghost/{{ .chezmoi.homeDir }}

# ghost wins a genuine conflict. Unison still refuses silently-losing cases and
# asks; this only settles the ones it can decide.
prefer = ssh://fade@ghost/{{ .chezmoi.homeDir }}

# --- what crosses ---------------------------------------------------------
path = SourceCode
path = .cache/opencode/projects
path = .config/opencode
path = .local/share/opencode
path = .claude/skills
path = .claude/playbooks
path = .claude/agents
path = .claude/commands
path = .claude/settings.json
path = .claude/CLAUDE.md

# --- what does not --------------------------------------------------------
# Build output, environments and caches: all regenerated by building.
ignore = Name *.fasl
ignore = Name *.fas
ignore = Name *.lib
ignore = Name *.pyc
ignore = Name __pycache__
ignore = Name node_modules
ignore = Name .venv
ignore = Name venv
ignore = Name .direnv
ignore = Name installer_files
ignore = Name .terraform
ignore = Name .mypy_cache
ignore = Name .pytest_cache
ignore = Name target
ignore = Name dist

# Model weights and database dumps: large, and downloadable or regenerable.
ignore = Name *.ckpt
ignore = Name *.safetensors
ignore = Name *.pth
ignore = Name *.dump
ignore = Name *.sql

# Three repositories whose packed history runs to gigabytes and lives complete
# on its remote. Their working trees still cross; only the history is skipped.
ignore = Path SourceCode/lisp/eve-quant/.git
ignore = Path SourceCode/emacs/.git
ignore = Path SourceCode/chrome/.git

# Session transcripts, which are large and are not configuration.
ignore = Path .claude/projects
ignore = Path .claude/file-history
ignore = Path .claude/shell-snapshots

# --- behaviour ------------------------------------------------------------
auto = true
batch = false
times = true
perms = 0o1777
sshargs = -C
maxthreads = 8
logfile = {{ .chezmoi.homeDir }}/.unison/ghost.log
