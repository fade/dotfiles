# Two-way sync of the working set against ghost, which is the root of truth.
#
# Run it as: unison ghost
#
# What is here is what I would be sorry to lose and cannot get back from
# anywhere else: work in progress, the agent configuration, and the planning
# directories that every project symlinks into. What is not here is anything a
# remote, a package manager or a download already holds.

root = {{ .chezmoi.homeDir }}
root = ssh://fade@ghost/{{ .chezmoi.homeDir }}

# ghost wins a genuine conflict. Unison still refuses silently-losing cases and
# asks; this only settles the ones it can decide.
prefer = ssh://fade@ghost/{{ .chezmoi.homeDir }}

# --- what crosses ---------------------------------------------------------
path = SourceCode
path = .cache/opencode/projects
path = .config/opencode
path = .local/share/opencode
path = .claude/skills
path = .claude/playbooks
path = .claude/agents
path = .claude/commands
path = .claude/settings.json
path = .claude/CLAUDE.md
path = .claude/projects

# Firefox: the profile I actually use. Close Firefox on both hosts before a run;
# its databases are written while it runs, and a copy taken mid-write is not a usable profile.
path = .mozilla/firefox/xw8b3c5r.Fade
ignore = Path .mozilla/firefox/xw8b3c5r.Fade/lock
ignore = Path .mozilla/firefox/xw8b3c5r.Fade/.parentlock

# --- what does not --------------------------------------------------------
# Build output, environments and caches: all regenerated by building.
ignore = Name *.fasl
ignore = Name *.fas
ignore = Name *.lib
ignore = Name *.pyc
ignore = Name __pycache__
ignore = Name node_modules
ignore = Name .venv
ignore = Name venv
ignore = Name .direnv
ignore = Name installer_files
ignore = Name .terraform
ignore = Name .mypy_cache
ignore = Name .pytest_cache
ignore = Name .stack-work

# Built per host: a core only loads under the SBCL runtime that made it.
ignore = Name dsmr.core
ignore = Name dsmr.core.*
ignore = Path SourceCode/lisp/dsmr-mcp/bin

# Compiled Emacs Lisp only loads under the Emacs build that compiled it.
ignore = Name *.elc
ignore = Name *.eln
ignore = Name eln-cache

# A directory called dist or target is as often source as build output: valis
# keeps code in src/dist, and hacl-star tracks over a thousand files in dist.
# So I name build trees by their own layout or by where they live, never by
# that bare name. Missing one costs bandwidth; a bare name silently skipped
# source.
ignore = Regex SourceCode/.*/target/(debug|release)
ignore = Path SourceCode/lisp/DeepSkyV2/valis/dist
ignore = Path SourceCode/neuranet/page-builder/editor-ui/dist
ignore = Path SourceCode/lisp/clojure/target
ignore = Path SourceCode/archive.lisp/clojure/target

# Model weights and database dumps: large, and downloadable or regenerable.
ignore = Name *.ckpt
ignore = Name *.safetensors
ignore = Name *.pth
ignore = Name *.dump
ignore = Name *.sql

# Two repositories whose packed history runs to gigabytes and lives complete
# on its remote. Their working trees still cross; only the history is skipped.
ignore = Path SourceCode/lisp/eve-quant/.git
ignore = Path SourceCode/chrome/.git

# The Emacs source tree stays home entirely. It is an upstream checkout that
# each machine pulls and builds for itself, and its build lands in the tree:
# objects, dumps, binaries, generated Lisp. Carrying the tree without its
# history also leaves each machine's git reporting the other's files as edits.
ignore = Path SourceCode/emacs

# Podman's image and container store belongs to the machine that pulled and
# built it. Its layers are owned by mapped user ids this side cannot read or
# recreate, and every image comes back from its registry or its Containerfile.
ignore = Path .local/share/containers

# Claude's per-machine state: transcripts, live sessions, the daemon, caches,
# credentials and local grants. None of it means anything on the other machine,
# and the memory under .claude/projects still crosses below.
ignore = Path .claude/file-history
ignore = Path .claude/shell-snapshots
ignore = Path .claude/sessions
ignore = Path .claude/session-env
ignore = Path .claude/daemon*
ignore = Path .claude/paste-cache
ignore = Path .claude/backups
ignore = Path .claude/.backups
ignore = Path .claude/cache
ignore = Path .claude/debug
ignore = Path .claude/state
ignore = Path .claude/jobs
ignore = Path .claude/tasks
ignore = Path .claude/todos
ignore = Path .claude/statsig
ignore = Path .claude/ide
ignore = Path .claude/history.jsonl
ignore = Path .claude/stats-cache.json
ignore = Path .claude/.last-cleanup
ignore = Path .claude/.credentials.json
ignore = Path .claude/settings.local.json

# The one thing I want out of .claude/projects is the memory each agent keeps.
# The transcripts beside it are the bulk and are worthless on the other machine,
# so I take everything a level down out and put memory back by name. A new kind
# of file appearing next to it then stays put until I say otherwise.
ignore = Regex \.claude/projects/[^/]*/[^/]*
ignorenot = Regex \.claude/projects/[^/]*/memory

# Claude prunes old transcripts on its own schedule and then removes the empty
# project directory. On this machine that looked like a deletion, and it took
# the whole directory on ghost, transcripts and all. A project directory now
# never goes on ghost because it went here; a single memory page still does.
nodeletionpartial = Regex \.claude/projects/[^/]* -> ssh://fade@ghost/{{ .chezmoi.homeDir }}

# --- behaviour ------------------------------------------------------------
auto = true
batch = false
times = true
perms = 0o1777
sshargs = -C
maxthreads = 8
logfile = {{ .chezmoi.homeDir }}/.unison/ghost.log
