#!/usr/bin/env bash
set -euo pipefail

# The emacs configuration this machine runs.
parent="{{ .chezmoi.homeDir }}/emacs-config"
target="$parent/emacs-for-common-lisp"
repo="https://github.com/fade/emacs-for-common-lisp.git"

if [ -d "$target/.git" ]; then
    exit 0
fi

mkdir -p "$parent"

if [ -e "$target" ] && [ ! -d "$target" ]; then
    echo "run_once: $target exists and is not a directory; aborting" >&2
    exit 1
fi

if [ -d "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null || true)" ]; then
    echo "run_once: $target exists and is non-empty but not a git repo; aborting" >&2
    exit 1
fi

# A public repository, so this needs no credential and works on a host that
# has none. Never prompt: a host being provisioned has nobody at the keyboard.
GIT_TERMINAL_PROMPT=0 git clone "$repo" "$target"
