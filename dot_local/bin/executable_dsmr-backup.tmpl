#!/usr/bin/env bash
# Take a versioned snapshot of the working set. Run it when you like; it is
# cheap after the first one because borg only stores what changed.
#
# Where unison keeps the two machines the same, this keeps the past: it is what
# you reach for when the answer is "it was fine yesterday".
set -euo pipefail

{{ if eq .chezmoi.hostname "ghost" -}}
# ghost holds the repositories the travelling machines push into, so it has
# nowhere to push its own. I send them to the other physical disk instead: a
# snapshot beside the work it came from answers "it was fine yesterday" and
# nothing else, and losing that disk would take both copies at once.
repo="${BORG_REPO:-/srv/borg/{{ .chezmoi.hostname }}}"
{{ else -}}
repo="${BORG_REPO:-ssh://fade@ghost/~/borg/{{ .chezmoi.hostname }}}"
{{ end -}}
conf="{{ .chezmoi.homeDir }}/.config/borg"
pass="$conf/passphrase"

# Outcome of the last run, for a status bar. Key=value lines, replaced whole on
# every run: state is ok or failed; rc is the exit status; time is UTC; step
# names the stage that ran last; message is that stage's last error line.
# A borg warning (rc 1) still reads ok, since every run on a host with
# unreadable container files ends that way.
status_dir="${XDG_STATE_HOME:-{{ .chezmoi.homeDir }}/.local/state}/dsmr-backup"
step=setup
message=
errlog=$(mktemp)
write_status() {
    local rc=$? state=ok
    [ -z "${borg_rc:-}" ] || rc=$borg_rc
    [ "$rc" -le 1 ] || state=failed
    [ "$step" != setup ] || [ "$rc" -eq 0 ] || state=failed
    mkdir -p "$status_dir"
    [ -n "$message" ] || message=$(grep -v '^\s*$' "$errlog" | tail -n 1 || true)
    {
        echo "state=$state"
        echo "rc=$rc"
        echo "time=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "host={{ .chezmoi.hostname }}"
        echo "step=$step"
        echo "message=${message//$'\n'/ }"
    } > "$status_dir/status.tmp"
    mv -f "$status_dir/status.tmp" "$status_dir/status"
    rm -f "$errlog"
}
trap write_status EXIT

# Run one borg stage, keeping its stderr for the status file and the journal.
run_step() {
    step=$1; shift
    local rc=0
    "$@" 2> "$errlog" || rc=$?
    cat "$errlog" >&2
    return "$rc"
}

if [ ! -r "$pass" ]; then
    message="no passphrase at $pass"
    echo "dsmr-backup: no passphrase at $pass" >&2
    echo "  The repository is encrypted and the passphrase is deliberately not" >&2
    echo "  in the dotfiles, which are public. Put it there, mode 600." >&2
    exit 1
fi

export BORG_REPO="$repo"
export BORG_PASSCOMMAND="cat $pass"
# A laptop that wandered onto a different network should fail, not hang.
export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"

mapfile -t paths < <(grep -vE '^\s*(#|$)' "$conf/include")
for p in "${paths[@]}"; do
    [ -e "$p" ] || { echo "dsmr-backup: skipping absent $p" >&2; continue; }
done

# A file borg could not read is a warning, and the archive is still made; borg
# says so with exit status 1. Only a real failure should stop the pruning.
rc=0
run_step create borg create --stats --compression zstd,3 \
    --exclude-from "$conf/exclude" \
    "::{{ .chezmoi.hostname }}-{now:%Y%m%dT%H%M%S}" \
    "${paths[@]}" || rc=$?
[ "$rc" -le 1 ] || exit "$rc"

# Keep enough history to answer "what did it look like last week" without the
# repository growing without bound.
run_step prune borg prune --stats --keep-daily 7 --keep-weekly 4 --keep-monthly 6
run_step compact borg compact
message=
: > "$errlog"
borg_rc=$rc
