#!/usr/bin/env bash
set -euo pipefail

# Configuration for the opencode assistant.
parent="{{ .chezmoi.homeDir }}/.config"
target="$parent/opencode"
repo="git@github-dsmr-opencode-config:fade/dsmr-opencode-config.git"

if [ -d "$target/.git" ]; then
    exit 0
fi

mkdir -p "$parent"

if [ -e "$target" ] && [ ! -d "$target" ]; then
    echo "run_once: $target exists and is not a directory; aborting" >&2
    exit 1
fi

if [ -d "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null || true)" ]; then
    echo "run_once: $target exists and is non-empty but not a git repo; aborting" >&2
    exit 1
fi

# Never sit at a prompt: nobody is at the keyboard of a machine being set up.
export GIT_TERMINAL_PROMPT=0

# fade/dsmr-opencode-config is private, so there is no anonymous url to fall back to. Say
# which credential is missing rather than failing on a url that could not have
# worked either way.
if ! git ls-remote "$repo" >/dev/null 2>&1; then
    echo "run_once: cannot read fade/dsmr-opencode-config." >&2
    echo "  It is private and this host has no key that reads it." >&2
    echo "  Expected an ssh host alias 'github-dsmr-opencode-config' in ~/.ssh/config naming a" >&2
    echo "  deploy key for that repository. Provisioning installs both." >&2
    exit 1
fi

git clone "$repo" "$target"
