#!/bin/sh
# Start the daily backup on any machine with a systemd user session. The
# service skips itself where there is no borg passphrase, so enabling it
# everywhere costs nothing on a machine that keeps no backups.
# unit hash: {{ include "dot_config/systemd/user/dsmr-backup.service" | sha256sum }} {{ include "dot_config/systemd/user/dsmr-backup.timer" | sha256sum }}
command -v systemctl >/dev/null 2>&1 || exit 0
systemctl --user daemon-reload >/dev/null 2>&1 || exit 0
systemctl --user enable --now dsmr-backup.timer >/dev/null 2>&1 || true
exit 0
